{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.intel.ai-playground",
  "asar": true,
  "copyright": "Copyright © Intel. All rights reserved",
  "extraResources": [
    {
      "from": "../service",
      "to": "service",
      "filter": ["*.py", "model_config.json", "pyproject.toml", "uv.lock"]
    },
    {
      "from": "../OpenVINO",
      "to": "OpenVINO",
      "filter": ["*.py", "pyproject.toml", "uv.lock"]
    },
    {
      "from": "../modes",
      "to": "modes"
    },
    {
      "from": "../device-service",
      "to": "device-service"
    },
    {
      "from": "../comfyui-deps",
      "to": "comfyui-deps"
    },
    {
      "from": "external/backend-versions.json",
      "to": "backend-versions.json"
    },
    {
      "from": "external/models.json",
      "to": "models.json"
    },
    {
      "from": "external/model_config.json",
      "to": "model_config.json"
    },
    {
      "from": "external/mcp.json",
      "to": "mcp.json"
    },
    {
      "from": "build/settings.json",
      "to": "settings.json"
    },
    {
      "from": "external/hardware-recommendations.json",
      "to": "hardware-recommendations.json"
    },
    {
      "from": "../service/static/assets/",
      "to": "service/static/assets/"
    },
    {
      "from": "../3rdpartynoticeslicenses.txt",
      "to": "3rdpartynoticeslicenses.txt"
    },
    {
      "from": "external",
      "to": ".",
      "filter": ["*.whl"]
    }
  ],
  "productName": "AI Playground",
  "directories": {
    "app": ".",
    "output": "../build/electron",
    "buildResources": "build"
  },
  "files": [
    {
      "from": "../build/dist",
      "to": "dist"
    },
    {
      "from": ".",
      "to": ".",
      "filter": ["package.json"]
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "extraResources": [
      {
        "from": "../build/resources/7zr.exe",
        "to": "7zr.exe"
      },
      {
        "from": "../build/resources/uv.exe",
        "to": "uv.exe"
      },
      {
        "from": "../build/resources/xpu-smi.exe",
        "to": "device-service/xpu-smi.exe"
      },
      {
        "from": "../build/resources/xpum.dll",
        "to": "device-service/xpum.dll"
      }
    ],
    "verifyUpdateCodeSignature": false,
    "requestedExecutionLevel": "asInvoker",
    "icon": "app.ico",
    "artifactName": "${productName}-${version}.${ext}",
    "electronLanguages": ["en-US", "zh-CN"]
  },
  "nsis": {
    "license": "build/license.rtf",
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": true,
    "allowElevation": true
  },
  "linux": {
    "maintainer": "Intel Corporation <ai.playground@intel.com>",
    "target": [
      {
        "target": "deb",
        "arch": ["x64"]
      }
    ],
    "extraResources": [
      {
        "from": "../build/resources/7zr",
        "to": "7zr"
      },
      {
        "from": "../build/resources/uv",
        "to": "uv"
      }
    ],
    "icon": "app.png",
    "artifactName": "${productName}-${version}.${ext}",
    "category": "Utility",
    "synopsis": "Intel AI Playground - local AI on Intel GPU",
    "description": "Run large language models and image generation locally on your Intel GPU. Powered by LlamaCPP, ComfyUI and OpenVINO."
  },
  "deb": {
    "synopsis": "Intel AI Playground - local AI on Intel GPU",
    "compression": "gz",
    "afterInstall": "build/linux/postinst",
    "afterRemove": "build/linux/prerm",
    "depends": [
      "libdbus-1-3",
      "libgtk-3-0 | libgtk-4-1",
      "libnss3",
      "libasound2 | libasound2t64",
      "libatspi2.0-0",
      "libdrm2",
      "libgbm1",
      "libxcb-dri3-0",
      "libvulkan1",
      "mesa-vulkan-drivers",
      "pciutils",
      "curl",
      "git",
      "unzip",
      "xvfb",
      "python3",
      "python3-dev",
      "build-essential",
      "cmake",
      "pkg-config",
      "ninja-build",
      "meson",
      "libcairo2-dev",
      "libgirepository1.0-dev",
      "libglib2.0-dev",
      "libjpeg-dev",
      "libpng-dev",
      "zlib1g-dev",
      "libssl-dev",
      "libgl1",
      "ffmpeg",
      "libavformat-dev",
      "libavcodec-dev",
      "libavutil-dev",
      "libswscale-dev"
    ]
  }
}
